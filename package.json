{
	"name": "credit-counter",
	"displayName": "Credit Counter",
	"description": "Track, label, and visualize the cost of your local Copilot and Claude Code chat sessions.",
	"version": "0.0.2",
	"publisher": "local",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Visualization",
		"Other"
	],
	"main": "./dist/extension.js",
	"activationEvents": [],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "creditCounter",
					"title": "Credit Counter",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"creditCounter": [
				{
					"id": "creditCounter.labels",
					"name": "Label Management"
				},
				{
					"id": "creditCounter.sessions",
					"name": "Chat Sessions"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "creditCounter.labels",
				"contents": "[$(graph) Open Dashboard](command:creditCounter.openDashboard)\n\nNo labels yet.\n[$(add) Add Label](command:creditCounter.addLabel)\n"
			},
			{
				"view": "creditCounter.sessions",
				"contents": "No chat sessions found.\nCost data is read from your local Copilot and Claude Code chat logs.\n[$(refresh) Refresh](command:creditCounter.refreshSessions)\n"
			}
		],
		"commands": [
			{
				"command": "creditCounter.openDashboard",
				"title": "Open Dashboard",
				"category": "Credit Counter",
				"icon": "$(graph)"
			},
			{
				"command": "creditCounter.addLabel",
				"title": "Add Label",
				"category": "Credit Counter",
				"icon": "$(add)"
			},
			{
				"command": "creditCounter.renameLabel",
				"title": "Rename Label",
				"category": "Credit Counter",
				"icon": "$(edit)"
			},
			{
				"command": "creditCounter.deleteLabel",
				"title": "Delete Label",
				"category": "Credit Counter",
				"icon": "$(trash)"
			},
			{
				"command": "creditCounter.assignLabel",
				"title": "Assign Label",
				"category": "Credit Counter"
			},
			{
				"command": "creditCounter.copyMetadata",
				"title": "Copy Metadata",
				"category": "Credit Counter",
				"icon": "$(copy)"
			},
			{
				"command": "creditCounter.refreshSessions",
				"title": "Refresh Sessions",
				"category": "Credit Counter",
				"icon": "$(refresh)"
			},
			{
				"command": "creditCounter.filterSessions",
				"title": "Filter Sessions",
				"category": "Credit Counter",
				"icon": "$(filter)"
			},
			{
				"command": "creditCounter.clearFilter",
				"title": "Clear Filter",
				"category": "Credit Counter",
				"icon": "$(filter-filled)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "creditCounter.openDashboard",
					"when": "view == creditCounter.labels",
					"group": "navigation@1"
				},
				{
					"command": "creditCounter.addLabel",
					"when": "view == creditCounter.labels",
					"group": "navigation@2"
				},
				{
					"command": "creditCounter.filterSessions",
					"when": "view == creditCounter.sessions",
					"group": "navigation@1"
				},
				{
					"command": "creditCounter.clearFilter",
					"when": "view == creditCounter.sessions && creditCounter.filterActive",
					"group": "navigation@2"
				},
				{
					"command": "creditCounter.refreshSessions",
					"when": "view == creditCounter.sessions",
					"group": "navigation@3"
				}
			],
			"view/item/context": [
				{
					"command": "creditCounter.renameLabel",
					"when": "view == creditCounter.labels && viewItem == label",
					"group": "inline@1"
				},
				{
					"command": "creditCounter.deleteLabel",
					"when": "view == creditCounter.labels && viewItem == label",
					"group": "inline@2"
				},
				{
					"command": "creditCounter.assignLabel",
					"when": "view == creditCounter.sessions && viewItem == session",
					"group": "1_assign"
				},
				{
					"command": "creditCounter.copyMetadata",
					"when": "view == creditCounter.sessions && viewItem == session",
					"group": "9_copy"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "node esbuild.js",
		"watch": "node esbuild.js --watch",
		"package": "node esbuild.js --production",
		"lint": "eslint src --ext ts",
		"pretest": "npm run lint",
		"test": "cross-env TS_NODE_PROJECT=tsconfig.test.json mocha"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.x",
		"@types/sql.js": "^1.4.11",
		"@types/vscode": "^1.90.0",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0",
		"chart.js": "^4.5.1",
		"cross-env": "^10.1.0",
		"esbuild": "^0.21.0",
		"eslint": "^8.57.0",
		"mocha": "^11.7.6",
		"ts-node": "^10.9.2",
		"typescript": "^5.4.0"
	},
	"dependencies": {
		"sql.js": "^1.14.1"
	}
}
